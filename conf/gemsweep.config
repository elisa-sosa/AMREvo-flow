params {
    max_cpus   = 64
    max_memory = '120.GB'
    max_time   = '96.h'
}

workDir = '/shares/amr.imm.uzh/data/projects/AMREvo_Flow/work/gemsweep'

process {
    executor       = 'slurm'
    clusterOptions = '--account=amr.imm.uzh'
    cache          = 'lenient'
    stageInMode    = 'symlink'

    withLabel: request_temp {
        clusterOptions = '--account=amr.imm.uzh'
    }

    withName: 'VALIDATE_PREBUILT_INPUT:THEMISTO_STATS' {
        memory = '4.GB'
        time   = '1.h'
    }

    withName: 'THEMISTO_PSEUDOALIGN' {
        cpus   = 16
        memory = '8.GB'
        time   = '2.h'
    }

    withName: 'MSWEEP' {
        cpus   = 4
        memory = '48.GB'
        time   = '4.h'
    }

    withName: 'MGEMS' {
        cpus   = 4
        memory = '16.GB'
        time   = '4.h'
    }
}

executor {
    queueSize       = 100
    submitRateLimit = '10/1sec'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/shares/amr.imm.uzh/data/projects/AMREvo_Flow/work/apptainer_cache'
}
