process {
    executor       = 'slurm'
    clusterOptions = '--account=amr.imm.uzh'
    stageInMode    = 'symlink'
    scratch        = false

    withLabel: validation {
        cpus   = 4
        memory = '24 GB'
        time   = '24 h'
    }

    withLabel: qc_light {
        cpus   = 2
        memory = '8 GB'
        time   = '6 h'
    }

    withLabel: qc_medium {
        cpus   = 4
        memory = '16 GB'
        time   = '12 h'
    }

    withLabel: assembly_heavy {
        cpus   = 16
        memory = '64 GB'
        time   = '48 h'
    }

    withLabel: polish_heavy {
        cpus   = 16
        memory = '64 GB'
        time   = '48 h'
    }

    withLabel: checkm2_heavy {
        cpus   = 16
        memory = '64 GB'
        time   = '24 h'
    }

    withLabel: gtdbtk_heavy {
        cpus   = 32
        memory = '180 GB'
        time   = '24 h'
    }

    withLabel: typing_light {
        cpus   = 4
        memory = '16 GB'
        time   = '12 h'
    }

    withLabel: typing_medium {
        cpus   = 8
        memory = '32 GB'
        time   = '12 h'
    }

    withLabel: reporting {
        cpus   = 4
        memory = '16 GB'
        time   = '4 h'
    }

    withLabel: phylogeny {
        cpus   = 8
        memory = '64 GB'
        time   = '48 h'
    }

    withLabel: sweep_pseudoalign {
        cpus   = 16
        memory = '8 GB'
        time   = '2 h'
    }

    withLabel: sweep_estimate {
        cpus   = 4
        memory = '48 GB'
        time   = '4 h'
    }
}

executor {
    queueSize       = 100
    submitRateLimit = '10/1sec'
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/shares/amr.imm.uzh/data/projects/AMREvo_Flow/work/apptainer_cache'
}

workDir = '/shares/amr.imm.uzh/data/projects/AMREvo_Flow/work'

params {
    fastqc_image     = '/shares/amr.imm.uzh/bioinfo/singularity/sandbox/fastqc_0.11.9'
    multiqc_image    = '/shares/amr.imm.uzh/data/projects/AMREvo_Flow/containers/images/reporting_multiqc-1.33_matplotlib-3.11.2_procps.sif'
    nanoplot_image   = '/shares/amr.imm.uzh/bioinfo/singularity/NanoPlot_1.44.1.sif'
    unicycler_image  = '/shares/amr.imm.uzh/bioinfo/singularity/sandbox/unicycler_0.5.0'
    medaka_image     = '/shares/amr.imm.uzh/bioinfo/singularity/medaka_2.0.0.sif'
    bwa_mem2_image   = '/shares/amr.imm.uzh/bioinfo/singularity/bwa-mem2_2.2.1--he70b90d_6.sif'
    polypolish_image = '/shares/amr.imm.uzh/bioinfo/singularity/polypolish_0.6.0.sif'
    pypolca_image    = '/shares/amr.imm.uzh/bioinfo/singularity/pypolca_0.3.1.sif'
    quast_image      = '/shares/amr.imm.uzh/bioinfo/singularity/sandbox/quay.io-biocontainers-quast-5.0.2--py37pl5262h190e900_4'
    checkm2_image    = '/shares/amr.imm.uzh/bioinfo/singularity/checkm2_1.0.2.sif'
    checkm2_db       = '/shares/amr.imm.uzh/bioinfo/databases/CheckM2_database/uniref100.KO.1.dmnd'
    gtdbtk_image     = '/shares/amr.imm.uzh/bioinfo/singularity/gtdbtk_2.6.1--pyh1f0d9b5_2.sif'
    gtdbtk_db        = '/shares/amr.imm.uzh/bioinfo/databases/gtdbtk_r226'
    mlst_image       = '/shares/amr.imm.uzh/bioinfo/singularity/mlst_2.33.1--hdfd78af_0.sif'
    amrfinder_image  = '/shares/amr.imm.uzh/bioinfo/singularity/amrfinderplus_4.2.7_2026-08-07.1.sif'
    ktypr_image      = '/shares/amr.imm.uzh/data/projects/AMREvo_Flow/containers/images/ktypr_1.0.1_b2e492530d53.sif'
    snippy_image     = '/shares/amr.imm.uzh/bioinfo/singularity/sandbox/snippy_4.6.0--hdfd78af_2'
    gubbins_image    = '/shares/amr.imm.uzh/bioinfo/singularity/gubbins_3.3.0--py310pl5321h8472f5a_0.sif'
    reporting_image  = '/shares/amr.imm.uzh/data/projects/AMREvo_Flow/containers/images/reporting_multiqc-1.33_matplotlib-3.11.2_procps.sif'
}
