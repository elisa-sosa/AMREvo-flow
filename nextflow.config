manifest {
    name            = 'amrevo-flow'
    author          = 'Applied Microbiology Research, University of Zurich'
    description     = 'Incremental AMREvo isolate and sweep sequencing workflow'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.6'
}

params {
    help               = false
    isolate_samples   = null
    isolate_read_units = null
    sweep_samples     = null
    sweep_read_units  = null
    qc_overrides      = null
    allowed_roots     = []

    outdir            = 'results'
    run_id            = null
    validate_only     = false
    render_plots      = true
    enable_isolates   = true
    enable_sweeps     = true
    retry_failed      = true
    fastq_validation  = 'full'

    ont_min_bases     = 5_000_000
    ont_min_n50       = 1_000
    ont_min_mean_q    = 9.0
    assembly_pass_completeness = 99.0
    assembly_min_completeness  = 95.0
    assembly_pass_contamination = 1.0
    assembly_max_contamination  = 5.0

    fastqc_image      = null
    multiqc_image     = null
    nanoplot_image    = null
    unicycler_image   = null
    medaka_image      = null
    bwa_mem2_image    = null
    polypolish_image  = null
    pypolca_image     = null
    quast_image       = null
    checkm2_image     = null
    checkm2_db        = null
    gtdbtk_image      = null
    gtdbtk_db         = null
    mlst_image        = null
    amrfinder_image   = null
    ktypr_image       = null
    snippy_image      = null
    gubbins_image     = null
    reporting_image   = null

    gemsweep_dir      = 'vendor/gemsweep/checkout'
    gemsweep_commit   = 'd06885f'
    gemsweep_index    = null
    gemsweep_ref_groups = null
    carriage_references = null

    // Used only by gemsweep_finalize.nf, after the separate GEMSWEEP run.
    manifest           = null
    resolved           = null
    gemsweep_output    = null
    index_prefix       = null
    ref_groups         = null
}

process {
    executor      = 'local'
    errorStrategy = { task.attempt < 2 ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = -1
    shell         = ['/bin/bash', '-euo', 'pipefail']
}

timeline {
    enabled = true
    file    = "${params.outdir}/logs/${params.run_id ?: 'nextflow'}_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/logs/${params.run_id ?: 'nextflow'}_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/logs/${params.run_id ?: 'nextflow'}_trace.tsv"
    fields  = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.outdir}/logs/${params.run_id ?: 'nextflow'}_dag.html"
    overwrite = true
}

profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    test {
        process.executor = 'local'
        process.cpus     = 1
        process.memory   = '1 GB'
        process.time     = '10 min'
        params.outdir    = 'test-output'
        params.fastq_validation = 'headers'
        params.render_plots = false
    }
}

workflow.onComplete = {
    def current = java.nio.file.Paths.get(params.outdir.toString()).toAbsolutePath().resolve('cohort/current')
    if (params.help) {
        // The help path schedules nothing and has no result products to report.
    } else if (workflow.success && params.validate_only) {
        println 'AMREvoFlow manifest validation completed; no analytical processes were scheduled.'
    } else if (workflow.success) {
        println "AMREvoFlow finished. Status: ${current.resolve('sample_status.tsv')}"
        println "Summary: ${current.resolve('run_summary.txt')}"
        if (params.render_plots) {
            println "Dashboard: ${current.resolve('plots/pipeline_status.png')}"
        } else {
            println 'Dashboard rendering was disabled for this run.'
        }
    } else {
        System.err.println('WARNING: AMREvoFlow ended PARTIALLY COMPLETE. Completed per-sample results were preserved.')
        System.err.println('Recover with -resume after correcting the reported failure.')
        System.err.println("Last status table, when reporting completed: ${current.resolve('sample_status.tsv')}")
    }
}
